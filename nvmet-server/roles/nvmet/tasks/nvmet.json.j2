{
  "hosts": [
    {% for clt in _nvmet_clients %}{
      "nqn": "{{ "nqn.2014-08.org.nvmexpress:uuid:" ~ clt }}"
    }{{ "," if loop.revindex != 1 else "" }}{% endfor %}
  ],
  "ports": [
    {% for addr in _nvmet_ip_addrs %}
    {
      "addr": {
        "adrfam": "{{ 'ipv6' if ':' in addr else 'ipv4' }}",
        "traddr": "{{ addr }}",
        "trsvcid": "4420",
        "trtype": "tcp"
      },
      "portid": {{ loop.index }},
      "subsystems": [
        {% for subsys in nvmet_subsystems %}
	"{{ nvmet_subsysnqn_format.format(loop.index) }}"{{ "," if loop.revindex != 1 else "" }}
	{% endfor %}
      ]
    }{{ "," if loop.revindex != 1 else "" }}
    {% endfor %}
  ],
  "subsystems": [
    {% for subsys in nvmet_subsystems %}
    {
      "allowed_hosts": [
         {% for hs in subsys.hosts %}
         "{{ "nqn.2014-08.org.nvmexpress:uuid:" ~ hs }}"{{ "," if loop.revindex != 1 else "" }}
	 {% endfor %}
      ],
      "attr": {
        "allow_any_host": "0"
      },
      "namespaces": [
        {% for ds in subsys.disks %}
        {
          "ana_grpid": 1,
          "device": {
            "path": "{{ "/dev/" ~ _nvmet_disks[ds - 1] }}"
          },
          "enable": 1,
          "nsid": {{ loop.index }}
        }{{ "," if loop.revindex != 1 else "" }}
	{% endfor %}
      ],
      "nqn": "{{ nvmet_subsysnqn_format.format(loop.index) }}"
    }{{ "," if loop.revindex != 1 else "" }}
    {% endfor %}
  ]
}
